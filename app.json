{
  "expo": {
    "name": "CMU2-app",
    "slug": "CMU2-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cmu2app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fitplan.app"
    },
    "android": {
      "package": "com.fitplan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C142B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A FitPlan usa a tua localização para gravar o percurso da corrida, mesmo com o ecrã bloqueado.",
          "locationWhenInUsePermission": "A FitPlan usa a tua localização para gravar o percurso e a distância da corrida.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C142B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
